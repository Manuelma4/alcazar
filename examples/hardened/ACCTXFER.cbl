000100*================================================================
000200* ACCTXFER - INTERBANK FUNDS TRANSFER, NIGHTLY BATCH (HARDENED)
000300*
000400* Hardened counterpart of examples/vulnerable/ACCTXFER.cbl:
000500* - every file has a FILE STATUS that is checked after each I/O,
000600*   and record-length statuses 04/06 reject the record (an
000700*   over-long LINE SEQUENTIAL line also discards its split tail);
000800* - amounts stay signed end to end, receivers are wide enough and
000900*   negative amounts are rejected explicitly;
001000* - arithmetic uses ROUNDED and ON SIZE ERROR;
001100* - the fraud check is chosen from an allowlist of literal CALLs;
001200* - no shell: operations are notified through a queue file;
001300* - the database password comes from the environment and the
001400*   card number is only ever displayed masked.
001500*================================================================
001600 IDENTIFICATION DIVISION.
001700 PROGRAM-ID. ACCTXFER.
001800 AUTHOR. ALCAZAR DEMO.
001900 ENVIRONMENT DIVISION.
002000 INPUT-OUTPUT SECTION.
002100 FILE-CONTROL.
002200     SELECT XFER-IN ASSIGN TO "XFERIN.DAT"
002300         ORGANIZATION IS LINE SEQUENTIAL
002400         FILE STATUS IS WS-XFER-FS.
002500     SELECT XFER-LOG ASSIGN TO "XFERLOG.DAT"
002600         ORGANIZATION IS LINE SEQUENTIAL
002700         FILE STATUS IS WS-LOG-FS.
002800     SELECT OPS-QUEUE ASSIGN TO "OPSQUEUE.DAT"
002900         ORGANIZATION IS LINE SEQUENTIAL
003000         FILE STATUS IS WS-OPS-FS.
003100 DATA DIVISION.
003200 FILE SECTION.
003300 FD  XFER-IN.
003400 01  XFER-IN-REC.
003500     05  IN-FROM-ACCT            PIC X(12).
003600     05  IN-TO-ACCT              PIC X(12).
003700     05  IN-CARD-PAN             PIC X(16).
003800     05  IN-AMOUNT               PIC S9(9)V99
003900                                 SIGN LEADING SEPARATE.
004000     05  IN-BENEF-NAME           PIC X(40).
004100     05  IN-ROUTE-CODE           PIC X(8).
004200 FD  XFER-LOG.
004300 01  XFER-LOG-REC                PIC X(132).
004400 FD  OPS-QUEUE.
004500 01  OPS-QUEUE-REC.
004600     05  OPS-EVENT               PIC X(8).
004700     05  OPS-FROM-ACCT           PIC X(12).
004800     05  OPS-AMOUNT              PIC -(9)9.99.
004900 WORKING-STORAGE SECTION.
005000 01  WS-XFER-FS                  PIC XX.
005100     88  XFER-OK                 VALUE "00".
005200     88  XFER-LENGTH-ERROR       VALUE "04" "06".
005300     88  XFER-EOF                VALUE "10".
005400 01  WS-LOG-FS                   PIC XX.
005500     88  LOG-OK                  VALUE "00".
005600 01  WS-OPS-FS                   PIC XX.
005700     88  OPS-OK                  VALUE "00".
005800 01  WS-SKIP-TAIL                PIC X VALUE "N".
005900     88  SKIP-TAIL               VALUE "Y".
006000 01  WS-DB-USER                  PIC X(8)  VALUE "XFERBAT".
006100 01  WS-DB-PASSWORD              PIC X(64).
006200 01  WS-FRAUD-RC                 PIC S9(4) COMP VALUE 0.
006300 01  WS-XFER-AMT                 PIC S9(9)V99.
006400 01  WS-POSTED-AMT               PIC S9(9)V99.
006500 01  WS-AUDIT-AMT                PIC S9(9)V99.
006600 01  WS-FEE-AMT                  PIC S9(7)V99.
006700 01  WS-FX-RATE                  PIC 9(3)V9(6) VALUE 1.
006800 01  WS-FX-AMT                   PIC S9(9)V99.
006900 01  WS-DAILY-LIMIT              PIC S9(9)V99 VALUE 10000.00.
007000 01  WS-WATCHLIST-HIT            PIC X VALUE "N".
007100 01  WS-BENEF-NAME               PIC X(40).
007200 01  WS-PAN-MASKED               PIC X(16).
007300 01  WS-XFER-COUNT               PIC 9(7) COMP VALUE 0.
007400 01  WS-REJECT-COUNT             PIC 9(7) COMP VALUE 0.
007500 01  WS-RETURN-CODE              PIC S9(4) COMP VALUE 0.
007600 01  WS-REJECTED-SW              PIC X VALUE "N".
007700     88  XFER-REJECTED           VALUE "Y".
007800 PROCEDURE DIVISION.
007900 0000-MAIN.
008000     ACCEPT WS-DB-PASSWORD FROM ENVIRONMENT
008100         "ACCTXFER_DB_PASSWORD"
008200     IF WS-DB-PASSWORD = SPACES
008300         DISPLAY "ACCTXFER: database credential not provided"
008400         MOVE 12 TO RETURN-CODE
008500         STOP RUN
008600     END-IF
008700     CALL "DBCONNECT" USING WS-DB-USER WS-DB-PASSWORD
008800     MOVE LOW-VALUES TO WS-DB-PASSWORD
008900     PERFORM 0100-OPEN-FILES
009000     PERFORM 1000-READ-NEXT
009100     PERFORM 2000-PROCESS-TRANSFER UNTIL XFER-EOF
009200     PERFORM 0900-CLOSE-FILES
009300     MOVE WS-RETURN-CODE TO RETURN-CODE
009400     STOP RUN.
009500
009600 0100-OPEN-FILES.
009700     OPEN INPUT XFER-IN
009800     IF NOT XFER-OK
009900         DISPLAY "ACCTXFER: XFERIN open status " WS-XFER-FS
010000         MOVE 16 TO RETURN-CODE
010100         STOP RUN
010200     END-IF
010300     OPEN EXTEND XFER-LOG
010400     IF NOT LOG-OK
010500         DISPLAY "ACCTXFER: XFERLOG open status " WS-LOG-FS
010600         MOVE 16 TO RETURN-CODE
010700         STOP RUN
010800     END-IF
010900     OPEN EXTEND OPS-QUEUE
011000     IF NOT OPS-OK
011100         DISPLAY "ACCTXFER: OPSQUEUE open status " WS-OPS-FS
011200         MOVE 16 TO RETURN-CODE
011300         STOP RUN
011400     END-IF.
011500
011600 0900-CLOSE-FILES.
011700     CLOSE XFER-IN XFER-LOG OPS-QUEUE.
011800
011900 1000-READ-NEXT.
012000*    LOW-VALUES first: a short record cannot reuse stale bytes.
012100     MOVE LOW-VALUES TO XFER-IN-REC
012200     READ XFER-IN
012300         AT END SET XFER-EOF TO TRUE
012400     END-READ
012500     EVALUATE TRUE
012600         WHEN XFER-EOF
012700             CONTINUE
012800         WHEN XFER-LENGTH-ERROR
012900*            Wrong length: reject it. When the line was too long
013000*            (06), also drop the tail returned by the next READ.
013100             IF WS-XFER-FS = "06"
013200                 SET SKIP-TAIL TO TRUE
013300             END-IF
013400             PERFORM 8100-REJECT-RECORD
013500             GO TO 1000-READ-NEXT
013600         WHEN XFER-OK AND SKIP-TAIL
013700             MOVE "N" TO WS-SKIP-TAIL
013800             GO TO 1000-READ-NEXT
013900         WHEN XFER-OK
014000             CONTINUE
014100         WHEN OTHER
014200             DISPLAY "ACCTXFER: read error, status " WS-XFER-FS
014300             MOVE 16 TO WS-RETURN-CODE
014400             SET XFER-EOF TO TRUE
014500     END-EVALUATE.
014600
014700 2000-PROCESS-TRANSFER.
014800     ADD 1 TO WS-XFER-COUNT
014900     MOVE "N" TO WS-REJECTED-SW
015000     MOVE IN-AMOUNT TO WS-XFER-AMT
015100     IF WS-XFER-AMT NOT > 0
015200         PERFORM 8000-REJECT-TRANSFER
015300     END-IF
015400     IF NOT XFER-REJECTED
015500         PERFORM 2200-PRICE-TRANSFER
015600     END-IF
015700     IF NOT XFER-REJECTED
015800         PERFORM 2300-POST-TRANSFER
015900     END-IF
016000     PERFORM 1000-READ-NEXT.
016100
016200 2200-PRICE-TRANSFER.
016300     MOVE WS-XFER-AMT TO WS-POSTED-AMT
016400     MOVE WS-XFER-AMT TO WS-AUDIT-AMT
016500     MOVE IN-BENEF-NAME TO WS-BENEF-NAME
016600     COMPUTE WS-FEE-AMT ROUNDED = WS-XFER-AMT * 0.0025
016700         ON SIZE ERROR
016800             PERFORM 8000-REJECT-TRANSFER
016900     END-COMPUTE
017000     COMPUTE WS-FX-AMT ROUNDED = WS-XFER-AMT / WS-FX-RATE
017100         ON SIZE ERROR
017200             PERFORM 8000-REJECT-TRANSFER
017300     END-COMPUTE
017400     IF WS-XFER-AMT > WS-DAILY-LIMIT OR WS-WATCHLIST-HIT = "Y"
017500         PERFORM 8000-REJECT-TRANSFER
017600     END-IF.
017700
017800*    Only a transfer that passed every check, including the fraud
017900*    check's return code, is routed and announced.
018000 2300-POST-TRANSFER.
018100     PERFORM 2100-MASK-PAN
018200     DISPLAY "XFER " IN-FROM-ACCT " CARD " WS-PAN-MASKED
018300     EVALUATE IN-ROUTE-CODE
018400         WHEN "STANDARD"
018500             CALL "FRAUDCHK" USING XFER-IN-REC WS-FRAUD-RC
018600         WHEN "PRIORITY"
018700             CALL "FRAUDPRI" USING XFER-IN-REC WS-FRAUD-RC
018800         WHEN OTHER
018900             MOVE 1 TO WS-FRAUD-RC
019000     END-EVALUATE
019100     IF WS-FRAUD-RC NOT = 0
019200         PERFORM 8000-REJECT-TRANSFER
019300     ELSE
019400         IF IN-ROUTE-CODE = "PRIORITY"
019500             PERFORM 3200-PRIORITY-ROUTE
019600         ELSE
019700             PERFORM 3100-STANDARD-ROUTE
019800         END-IF
019900         MOVE "XFERDONE" TO OPS-EVENT
020000         MOVE IN-FROM-ACCT TO OPS-FROM-ACCT
020100         MOVE WS-POSTED-AMT TO OPS-AMOUNT
020200         WRITE OPS-QUEUE-REC
020300         IF NOT OPS-OK
020400             MOVE 16 TO WS-RETURN-CODE
020500         END-IF
020600     END-IF.
020700
020800 2100-MASK-PAN.
020900     MOVE ALL "*" TO WS-PAN-MASKED
021000     MOVE IN-CARD-PAN(1:6) TO WS-PAN-MASKED(1:6)
021100     MOVE IN-CARD-PAN(13:4) TO WS-PAN-MASKED(13:4).
021200
021300 3100-STANDARD-ROUTE.
021400     MOVE WS-BENEF-NAME TO XFER-LOG-REC
021500     PERFORM 9000-WRITE-LOG.
021600
021700 3200-PRIORITY-ROUTE.
021800     MOVE "PRIORITY" TO XFER-LOG-REC
021900     PERFORM 9000-WRITE-LOG.
022000
022100 8000-REJECT-TRANSFER.
022200     SET XFER-REJECTED TO TRUE
022300     ADD 1 TO WS-REJECT-COUNT
022400     MOVE 4 TO WS-RETURN-CODE
022500     MOVE "REJECTED: LIMIT, SIGN OR ROUTE" TO XFER-LOG-REC
022600     PERFORM 9000-WRITE-LOG.
022700
022800 8100-REJECT-RECORD.
022900     ADD 1 TO WS-REJECT-COUNT
023000     MOVE 4 TO WS-RETURN-CODE
023100     MOVE "REJECTED: RECORD LENGTH" TO XFER-LOG-REC
023200     PERFORM 9000-WRITE-LOG.
023300
023400 9000-WRITE-LOG.
023500     WRITE XFER-LOG-REC
023600     IF NOT LOG-OK
023700         MOVE 16 TO WS-RETURN-CODE
023800     END-IF.
