000100*================================================================
000200* CUSTSQL - CUSTOMER LOOKUP AND CLEAN-UP AGAINST DB2
000300*
000400* !!! INTENTIONALLY VULNERABLE - DO NOT USE IN PRODUCTION !!!
000500* Demo material for Watchtower, the Alcazar static analyzer.
000600*
000700* REQUIRES AN SQL PRECOMPILER (IBM DB2 precompiler, ocesql, ...)
000800* before it can be compiled; the example compile check skips it.
000900*
001000* Planted flaws: SQL text concatenated from input and run with
001100* PREPARE ... FROM :host and EXECUTE IMMEDIATE :host.
001200*================================================================
001300 IDENTIFICATION DIVISION.
001400 PROGRAM-ID. CUSTSQL.
001500 DATA DIVISION.
001600 WORKING-STORAGE SECTION.
001700     EXEC SQL INCLUDE SQLCA END-EXEC.
001800     EXEC SQL BEGIN DECLARE SECTION END-EXEC.
001900 01  WS-CUST-ID                  PIC X(10).
002000 01  WS-CUST-NAME                PIC X(40).
002100 01  WS-CUST-BAL                 PIC S9(11)V99 COMP-3.
002200 01  WS-SQL-TEXT                 PIC X(512).
002300 01  WS-PURGE-SQL                PIC X(256).
002400     EXEC SQL END DECLARE SECTION END-EXEC.
002500 LINKAGE SECTION.
002600 01  LK-REQUEST.
002700     05  LK-CUST-ID              PIC X(10).
002800     05  LK-REGION               PIC X(20).
002900 PROCEDURE DIVISION USING LK-REQUEST.
003000 0000-MAIN.
003100     MOVE LK-CUST-ID TO WS-CUST-ID
003200     MOVE SPACES TO WS-SQL-TEXT
003300*    A customer id such as  X' OR '1'='1  returns every row.
003400     STRING "SELECT CUST_NAME, CUST_BAL FROM BANK.CUSTOMER "
003500            DELIMITED BY SIZE
003600            "WHERE CUST_ID = '" DELIMITED BY SIZE
003700            WS-CUST-ID DELIMITED BY SPACE
003800            "'" DELIMITED BY SIZE
003900            INTO WS-SQL-TEXT
004000     END-STRING
004100     EXEC SQL
004200         PREPARE CUSTSTMT FROM :WS-SQL-TEXT
004300     END-EXEC
004400     EXEC SQL DECLARE CUSTCUR CURSOR FOR CUSTSTMT END-EXEC
004500     EXEC SQL OPEN CUSTCUR END-EXEC
004600     EXEC SQL
004700         FETCH CUSTCUR INTO :WS-CUST-NAME, :WS-CUST-BAL
004800     END-EXEC
004900     EXEC SQL CLOSE CUSTCUR END-EXEC
005000*    Region names come straight from the request.
005100     STRING "DELETE FROM BANK.SESSION WHERE REGION = '"
005200            DELIMITED BY SIZE
005300            LK-REGION DELIMITED BY SPACE
005400            "'" DELIMITED BY SIZE
005500            INTO WS-PURGE-SQL
005600     END-STRING
005700     EXEC SQL EXECUTE IMMEDIATE :WS-PURGE-SQL END-EXEC
005800     GOBACK.
