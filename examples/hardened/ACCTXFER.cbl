000100*================================================================
000200* ACCTXFER - INTERBANK FUNDS TRANSFER, NIGHTLY BATCH (HARDENED)
000300*
000400* Hardened counterpart of examples/vulnerable/ACCTXFER.cbl:
000500* - every file has a FILE STATUS that is checked after each I/O,
000600*   and record-length statuses 04/06 reject the record (an
000700*   over-long LINE SEQUENTIAL line also discards its split tail);
000800* - amounts stay signed end to end, receivers are wide enough and
000900*   negative amounts are rejected explicitly;
001000* - arithmetic uses ROUNDED and ON SIZE ERROR;
001100* - the fraud check is chosen from an allowlist of literal CALLs;
001200* - no shell: operations are notified through a queue file;
001300* - the database password comes from the environment and the
001400*   card number is only ever displayed masked.
001500*================================================================
001600 IDENTIFICATION DIVISION.
001700 PROGRAM-ID. ACCTXFER.
001800 AUTHOR. ALCAZAR DEMO.
001900 ENVIRONMENT DIVISION.
002000 INPUT-OUTPUT SECTION.
002100 FILE-CONTROL.
002200     SELECT XFER-IN ASSIGN TO "XFERIN.DAT"
002300         ORGANIZATION IS LINE SEQUENTIAL
002400         FILE STATUS IS WS-XFER-FS.
002500     SELECT XFER-LOG ASSIGN TO "XFERLOG.DAT"
002600         ORGANIZATION IS LINE SEQUENTIAL
002700         FILE STATUS IS WS-LOG-FS.
002800     SELECT OPS-QUEUE ASSIGN TO "OPSQUEUE.DAT"
002900         ORGANIZATION IS LINE SEQUENTIAL
003000         FILE STATUS IS WS-OPS-FS.
003100 DATA DIVISION.
003200 FILE SECTION.
003300 FD  XFER-IN.
003400 01  XFER-IN-REC.
003500     05  IN-FROM-ACCT            PIC X(12).
003600     05  IN-TO-ACCT              PIC X(12).
003700     05  IN-CARD-PAN             PIC X(16).
003800     05  IN-AMOUNT               PIC S9(9)V99
003900                                 SIGN LEADING SEPARATE.
004000     05  IN-BENEF-NAME           PIC X(40).
004100     05  IN-ROUTE-CODE           PIC X(8).
004200 FD  XFER-LOG.
004300 01  XFER-LOG-REC                PIC X(132).
004400 FD  OPS-QUEUE.
004500 01  OPS-QUEUE-REC.
004600     05  OPS-EVENT               PIC X(8).
004700     05  OPS-FROM-ACCT           PIC X(12).
004800     05  OPS-AMOUNT              PIC -(9)9.99.
004900 WORKING-STORAGE SECTION.
005000 01  WS-XFER-FS                  PIC XX.
005100     88  XFER-OK                 VALUE "00".
005200     88  XFER-LENGTH-ERROR       VALUE "04" "06".
005300     88  XFER-EOF                VALUE "10".
005400 01  WS-LOG-FS                   PIC XX.
005500     88  LOG-OK                  VALUE "00".
005600 01  WS-OPS-FS                   PIC XX.
005700     88  OPS-OK                  VALUE "00".
005800 01  WS-SKIP-TAIL                PIC X VALUE "N".
005900     88  SKIP-TAIL               VALUE "Y".
006000 01  WS-DB-USER                  PIC X(8)  VALUE "XFERBAT".
006100 01  WS-DB-PASSWORD              PIC X(64).
006200 01  WS-FRAUD-RC                 PIC S9(4) COMP VALUE 0.
006300 01  WS-XFER-AMT                 PIC S9(9)V99.
006400 01  WS-POSTED-AMT               PIC S9(9)V99.
006500 01  WS-AUDIT-AMT                PIC S9(9)V99.
006600 01  WS-FEE-AMT                  PIC S9(7)V99.
006700 01  WS-FX-RATE                  PIC 9(3)V9(6) VALUE 1.
006800 01  WS-FX-AMT                   PIC S9(9)V99.
006900 01  WS-DAILY-LIMIT              PIC S9(9)V99 VALUE 10000.00.
007000 01  WS-WATCHLIST-HIT            PIC X VALUE "N".
007100 01  WS-BENEF-NAME               PIC X(40).
007200 01  WS-PAN-MASKED               PIC X(16).
007300 01  WS-XFER-COUNT               PIC 9(7) COMP VALUE 0.
007400 01  WS-REJECT-COUNT             PIC 9(7) COMP VALUE 0.
007500 01  WS-RETURN-CODE              PIC S9(4) COMP VALUE 0.
007600 PROCEDURE DIVISION.
007700 0000-MAIN.
007800     ACCEPT WS-DB-PASSWORD FROM ENVIRONMENT
007900         "ACCTXFER_DB_PASSWORD"
008000     IF WS-DB-PASSWORD = SPACES
008100         DISPLAY "ACCTXFER: database credential not provided"
008200         MOVE 12 TO RETURN-CODE
008300         STOP RUN
008400     END-IF
008500     CALL "DBCONNECT" USING WS-DB-USER WS-DB-PASSWORD
008600     MOVE LOW-VALUES TO WS-DB-PASSWORD
008700     PERFORM 0100-OPEN-FILES
008800     PERFORM 1000-READ-NEXT
008900     PERFORM 2000-PROCESS-TRANSFER UNTIL XFER-EOF
009000     PERFORM 0900-CLOSE-FILES
009100     MOVE WS-RETURN-CODE TO RETURN-CODE
009200     STOP RUN.
009300
009400 0100-OPEN-FILES.
009500     OPEN INPUT XFER-IN
009600     IF NOT XFER-OK
009700         DISPLAY "ACCTXFER: XFERIN open status " WS-XFER-FS
009800         MOVE 16 TO RETURN-CODE
009900         STOP RUN
010000     END-IF
010100     OPEN EXTEND XFER-LOG
010200     IF NOT LOG-OK
010300         DISPLAY "ACCTXFER: XFERLOG open status " WS-LOG-FS
010400         MOVE 16 TO RETURN-CODE
010500         STOP RUN
010600     END-IF
010700     OPEN EXTEND OPS-QUEUE
010800     IF NOT OPS-OK
010900         DISPLAY "ACCTXFER: OPSQUEUE open status " WS-OPS-FS
011000         MOVE 16 TO RETURN-CODE
011100         STOP RUN
011200     END-IF.
011300
011400 0900-CLOSE-FILES.
011500     CLOSE XFER-IN XFER-LOG OPS-QUEUE.
011600
011700 1000-READ-NEXT.
011800*    LOW-VALUES first: a short record cannot reuse stale bytes.
011900     MOVE LOW-VALUES TO XFER-IN-REC
012000     READ XFER-IN
012100         AT END SET XFER-EOF TO TRUE
012200     END-READ
012300     EVALUATE TRUE
012400         WHEN XFER-EOF
012500             CONTINUE
012600         WHEN XFER-LENGTH-ERROR
012700*            Wrong length: reject it. When the line was too long
012800*            (06), also drop the tail returned by the next READ.
012900             IF WS-XFER-FS = "06"
013000                 SET SKIP-TAIL TO TRUE
013100             END-IF
013200             PERFORM 8100-REJECT-RECORD
013300             GO TO 1000-READ-NEXT
013400         WHEN XFER-OK AND SKIP-TAIL
013500             MOVE "N" TO WS-SKIP-TAIL
013600             GO TO 1000-READ-NEXT
013700         WHEN XFER-OK
013800             CONTINUE
013900         WHEN OTHER
014000             DISPLAY "ACCTXFER: read error, status " WS-XFER-FS
014100             MOVE 16 TO WS-RETURN-CODE
014200             SET XFER-EOF TO TRUE
014300     END-EVALUATE.
014400
014500 2000-PROCESS-TRANSFER.
014600     ADD 1 TO WS-XFER-COUNT
014700     MOVE IN-AMOUNT TO WS-XFER-AMT
014800     IF WS-XFER-AMT NOT > 0
014900         PERFORM 8000-REJECT-TRANSFER
015000         PERFORM 1000-READ-NEXT
015100         EXIT PARAGRAPH
015200     END-IF
015300     MOVE WS-XFER-AMT TO WS-POSTED-AMT
015400     MOVE WS-XFER-AMT TO WS-AUDIT-AMT
015500     MOVE IN-BENEF-NAME TO WS-BENEF-NAME
015600     COMPUTE WS-FEE-AMT ROUNDED = WS-XFER-AMT * 0.0025
015700         ON SIZE ERROR
015800             PERFORM 8000-REJECT-TRANSFER
015900     END-COMPUTE
016000     COMPUTE WS-FX-AMT ROUNDED = WS-XFER-AMT / WS-FX-RATE
016100         ON SIZE ERROR
016200             PERFORM 8000-REJECT-TRANSFER
016300     END-COMPUTE
016400     IF WS-XFER-AMT > WS-DAILY-LIMIT OR WS-WATCHLIST-HIT = "Y"
016500         PERFORM 8000-REJECT-TRANSFER
016600     END-IF
016700     PERFORM 2100-MASK-PAN
016800     DISPLAY "XFER " IN-FROM-ACCT " CARD " WS-PAN-MASKED
016900     EVALUATE IN-ROUTE-CODE
017000         WHEN "STANDARD"
017100             CALL "FRAUDCHK" USING XFER-IN-REC WS-FRAUD-RC
017200             PERFORM 3100-STANDARD-ROUTE
017300         WHEN "PRIORITY"
017400             CALL "FRAUDPRI" USING XFER-IN-REC WS-FRAUD-RC
017500             PERFORM 3200-PRIORITY-ROUTE
017600         WHEN OTHER
017700             PERFORM 8000-REJECT-TRANSFER
017800     END-EVALUATE
017900     MOVE "XFERDONE" TO OPS-EVENT
018000     MOVE IN-FROM-ACCT TO OPS-FROM-ACCT
018100     MOVE WS-POSTED-AMT TO OPS-AMOUNT
018200     WRITE OPS-QUEUE-REC
018300     IF NOT OPS-OK
018400         MOVE 16 TO WS-RETURN-CODE
018500     END-IF
018600     PERFORM 1000-READ-NEXT.
018700
018800 2100-MASK-PAN.
018900     MOVE ALL "*" TO WS-PAN-MASKED
019000     MOVE IN-CARD-PAN(1:6) TO WS-PAN-MASKED(1:6)
019100     MOVE IN-CARD-PAN(13:4) TO WS-PAN-MASKED(13:4).
019200
019300 3100-STANDARD-ROUTE.
019400     MOVE WS-BENEF-NAME TO XFER-LOG-REC
019500     PERFORM 9000-WRITE-LOG.
019600
019700 3200-PRIORITY-ROUTE.
019800     MOVE "PRIORITY" TO XFER-LOG-REC
019900     PERFORM 9000-WRITE-LOG.
020000
020100 8000-REJECT-TRANSFER.
020200     ADD 1 TO WS-REJECT-COUNT
020300     MOVE 4 TO WS-RETURN-CODE
020400     MOVE "REJECTED: LIMIT, SIGN OR ROUTE" TO XFER-LOG-REC
020500     PERFORM 9000-WRITE-LOG.
020600
020700 8100-REJECT-RECORD.
020800     ADD 1 TO WS-REJECT-COUNT
020900     MOVE 4 TO WS-RETURN-CODE
021000     MOVE "REJECTED: RECORD LENGTH" TO XFER-LOG-REC
021100     PERFORM 9000-WRITE-LOG.
021200
021300 9000-WRITE-LOG.
021400     WRITE XFER-LOG-REC
021500     IF NOT LOG-OK
021600         MOVE 16 TO WS-RETURN-CODE
021700     END-IF.
